# ─── GMP ERP — переменные окружения ──────────────────────────────────────────
# Скопируйте в .env и задайте ПРОДАКШН-значения. Файл .env в git НЕ коммитить.

# PostgreSQL
POSTGRES_DB=gmp_erp
POSTGRES_USER=gmp_user
# ОБЯЗАТЕЛЬНО сменить на проде (длинный случайный пароль):
POSTGRES_PASSWORD=change-me-strong-password

# Backend
# Сильный случайный ключ подписи токенов/сессий (например: openssl rand -hex 32):
GMP_SECRET_KEY=change-me-please-32+random-hex

# Бэкап БД: сколько дней хранить дампы
BACKUP_KEEP_DAYS=14

# ─── Только для прод-overlay (docker-compose.prod.yml) ────────────────────────
# Домен сайта для автоматического TLS (Caddy/Let's Encrypt). Для внутренней
# сети без публичного домена используйте самоподписанный режим (см. Caddyfile).
SITE_DOMAIN=erp.example.local
# Хостовые пути для бэкапируемого/внешнего диска (true-copy сканов и дампов):
SCANS_HOST_PATH=/srv/gmp/qc-scans
DEFECT_PHOTOS_HOST_PATH=/srv/gmp/defect-photos
RECEIPT_CERTS_HOST_PATH=/srv/gmp/receipt-certificates
BACKUPS_HOST_PATH=/srv/gmp/backups
PGDATA_HOST_PATH=/srv/gmp/pgdata
